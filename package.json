{
  "name": "@geckou/ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Geckou UI — framework-agnostic core with Vue and React implementations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/ui.git"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "yarn workspaces run build",
    "build:demo": "vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint demo && yarn workspaces run lint",
    "lint:fix": "eslint demo --fix && yarn workspaces run lint:fix",
    "prepare": "husky",
    "preview:demo": "vite preview",
    "release": "bash scripts/release.sh",
    "test": "yarn workspaces run test",
    "test:api-diff": "bash scripts/test-api-diff.sh",
    "test:release-command": "bash scripts/test-release-command.sh",
    "type-check": "yarn workspaces run type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@geckou/commitlint-config": "^0.1.1",
    "@geckou/eslint-config": "^0.3.0",
    "@geckou/prettier-config": "^0.1.1",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.0.5",
    "@vue/test-utils": "^2.4.6",
    "eslint": "^9",
    "husky": "^9",
    "jsdom": "^25.0.0",
    "prettier": "^3",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass": "^1.83.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.0"
  }
}
