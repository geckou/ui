{
  "name": "@geckou/ui-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Geckou UI — framework-agnostic core with Vue and React implementations",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geckou/ui.git"
  },
  "author": "geckou-shogo <shogo.nojima@geckou.net>",
  "license": "MIT",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "yarn workspaces run build",
    "build:demo": "vite build",
    "preview:demo": "vite preview",
    "test": "yarn workspace @geckou/ui-core test",
    "type-check": "yarn workspaces run type-check",
    "lint": "eslint packages/*/src demo --ext .ts,.vue",
    "release": "bash scripts/release.sh"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.22.0",
    "@typescript-eslint/parser": "^8.22.0",
    "@vitejs/plugin-vue": "^5.0.5",
    "eslint": "^8.57.1",
    "eslint-plugin-vue": "^9.27.0",
    "sass": "^1.83.0",
    "typescript": "^5.5.3",
    "vite": "^5.3.3",
    "vite-plugin-dts": "^4.4.0",
    "vitest": "^2.1.9",
    "vue": "^3.5.13",
    "vue-tsc": "^2.1.0"
  }
}
