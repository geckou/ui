{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["packages/vue/src/*"],
      "~demo/*": ["demo/*"]
    },
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true
  },
  "include": ["demo/**/*"]
}
